<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    贴图透镜（Texture Lens）· 程序集
    本工程由旧 Steam 工坊包（3718454442）的 Source\ItemTextureViewer\ItemTextureViewer.csproj 迁移而来，
    手写的 <Reference>（指向本机游戏 Managed 目录）已换成工作区标准模板：
      - Krafs.Rimworld.Ref 提供 1.6.4871 的参考程序集（仅编译期，不进输出目录）
      - Lib.Harmony 2.4.2 提供 Harmony 编译引用 + 随包附带的 0Harmony.dll
    版本号三处同步：这里 / ItemTextureViewerMod.cs 的 Version 常量 / About\About.xml 的 <modVersion>。
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>

    <AssemblyName>ItemTextureViewer</AssemblyName>
    <RootNamespace>ItemTextureViewer</RootNamespace>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- RimWorld 不认 TFM 子目录，输出必须平铺 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <Version>2.8.1</Version>
    <Company>Redbean</Company>
    <Product>Texture Lens</Product>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- 编译产物直接落到 mod 的 Assemblies/ 下 -->
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\..\Assemblies"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 附带 Harmony 运行时（net472，游戏跑 Mono）。0Harmony.dll 的 "0" 前缀让 RimWorld 先加载它。 -->
  <Target Name="CopyHarmonyRuntime" AfterTargets="Build" Condition="Exists('$(PkgLib_Harmony)\lib\net472\0Harmony.dll')">
    <Copy SourceFiles="$(PkgLib_Harmony)\lib\net472\0Harmony.dll"
          DestinationFolder="$(MSBuildProjectDirectory)\..\..\Assemblies"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
